    {
      "measurement_id": "m_apple_000023",
      "parameter": "buttons | apple developer documentation__best_practices__https___developer_apple_com_design_human_interface_guidelines_buttons__best_practices_",
      "value": 44,
      "unit": "pt",
      "condition": "**Make buttons easy for people to use.** It’s essential to include enough space around a button so that people can visually distinguish it from surrounding components and content. Giving a button enough space is also critical for helping people select or activate it, regardless of the method of input they use. As a general rule, a button needs a hit region of at least 44x44 pt — in visionOS, 60x60 pt — to ensure that people can select it easily, whether they use a fingertip, a pointer, their eyes, or a remote.",
      "platform": "visionOS",
      "source_id": "apple_hig_buttons",
      "source_location": "Buttons | Apple Developer Documentation > [Best practices](https://developer.apple.com/design/human-interface-guidelines/buttons\\#Best-practices)"
    },
    {
      "measurement_id": "m_apple_000024",
      "parameter": "buttons | apple developer documentation__visionos__https___developer_apple_com_design_human_interface_guidelines_buttons__visionos_",
      "value": 28,
      "unit": "pt",
      "condition": "| Shape | Mini (28 pt) | Small (32 pt) | Regular (44 pt) | Large (52 pt) | Extra large (64 pt) |",
      "platform": "Universal Apple Platforms",
      "source_id": "apple_hig_buttons",
      "source_location": "Buttons | Apple Developer Documentation > [visionOS](https://developer.apple.com/design/human-interface-guidelines/buttons\\#visionOS)"
    },
    {
      "measurement_id": "m_apple_000025",
      "parameter": "buttons | apple developer documentation__visionos__https___developer_apple_com_design_human_interface_guidelines_buttons__visionos_",
      "value": 60,
      "unit": "pt",
      "condition": "**Provide enough space around a button to make it easy for people to look at it.** Aim to place buttons so their centers are always at least 60 pts apart. If your buttons measure 60 pts or larger, add 4 pts of padding around them to keep the hover effect from overlapping. Also, it’s usually best to avoid displaying small or mini buttons in a vertical stack or horizontal row.",
      "platform": "Universal Apple Platforms",
      "source_id": "apple_hig_buttons",
      "source_location": "Buttons | Apple Developer Documentation > [visionOS](https://developer.apple.com/design/human-interface-guidelines/buttons\\#visionOS)"
    },
